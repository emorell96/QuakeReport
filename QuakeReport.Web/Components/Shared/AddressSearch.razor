@inject GooglePlacesService GooglePlaces

<MudAutocomplete T="string"
                 Label="@Label"
                 For="@For"
                 Value="_selectedSuggestion"
                 ValueChanged="OnSuggestionSelectedAsync"
                 Text="@Address"
                 TextChanged="OnAddressTypedAsync"
                 SearchFunc="SearchAddressesAsync"
                 MinCharacters="GooglePlacesService.MinimumSearchLength"
                 DebounceInterval="350"
                 MaxItems="5"
                 Strict="false"
                 CoerceText="true"
                 CoerceValue="false"
                 ResetValueOnEmptyText="true"
                 Clearable="true"
                 ShowProgressIndicator="true"
                 Adornment="Adornment.Start"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 Placeholder="Escribe al menos 4 caracteres..."
                 HelperText="Las sugerencias de Google aparecen después de 4 caracteres"
                 Required="Required">
    <ItemTemplate Context="suggestion">
        <MudText Typo="Typo.body2">@suggestion</MudText>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.body2" Class="pa-2">
            @(string.IsNullOrWhiteSpace(_searchError) ? "No se encontraron direcciones." : _searchError)
        </MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    private string? _selectedSuggestion;
    private readonly Dictionary<string, GooglePlaceSuggestion> _suggestions = new(StringComparer.Ordinal);
    private string? _searchError;
    private string _sessionToken = CreateSessionToken();
    private string? _coordinateAddress;

    [Parameter]
    public string? Address { get; set; }

    [Parameter]
    public string Label { get; set; } = "Dirección (opcional - busca para fijar la ubicación exacta)";

    [Parameter]
    public System.Linq.Expressions.Expression<Func<string?>>? For { get; set; }

    [Parameter]
    public EventCallback<string?> AddressChanged { get; set; }

    [Parameter]
    public double? Latitude { get; set; }

    [Parameter]
    public double? Longitude { get; set; }

    /// <summary>Fired when a place is picked from the dropdown, with its coordinates.</summary>
    [Parameter]
    public EventCallback<(string Address, double Latitude, double Longitude)> OnPlaceSelected { get; set; }

    [Parameter]
    public EventCallback OnCoordinatesCleared { get; set; }
    [Parameter]
    public bool Required { get; set; } = false;

    protected override void OnParametersSet()
    {
        if (Latitude.HasValue && Longitude.HasValue)
        {
            _coordinateAddress ??= Address;
        }
        else
        {
            _coordinateAddress = null;
        }
    }

    private async Task<IEnumerable<string>> SearchAddressesAsync(
        string? value,
        CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value)
            || value.Trim().Length < GooglePlacesService.MinimumSearchLength)
        {
            _searchError = null;
            return [];
        }

        try
        {
            _searchError = null;
            var suggestions = await GooglePlaces.SearchAsync(
                value,
                Latitude,
                Longitude,
                _sessionToken,
                cancellationToken);
            _suggestions.Clear();
            foreach (var suggestion in suggestions)
            {
                _suggestions[suggestion.Description] = suggestion;
            }

            return _suggestions.Keys;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return [];
        }
        catch
        {
            _searchError = "La búsqueda de direcciones no está disponible en este momento.";
            return [];
        }
    }

    private async Task OnAddressTypedAsync(string? value)
    {
        if (Latitude.HasValue && Longitude.HasValue &&
            !string.Equals(value?.Trim(), _coordinateAddress?.Trim(), StringComparison.Ordinal))
        {
            _coordinateAddress = null;
            await OnCoordinatesCleared.InvokeAsync();
        }

        Address = value;
        if (_selectedSuggestion is not null
            && !string.Equals(value, _selectedSuggestion, StringComparison.Ordinal))
        {
            _selectedSuggestion = null;
        }

        await AddressChanged.InvokeAsync(value);
    }

    private async Task OnSuggestionSelectedAsync(string? selectedAddress)
    {
        _selectedSuggestion = selectedAddress;
        if (selectedAddress is null || !_suggestions.TryGetValue(selectedAddress, out var suggestion))
        {
            return;
        }

        try
        {
            var details = await GooglePlaces.GetDetailsAsync(
                suggestion.PlaceId,
                _sessionToken,
                CancellationToken.None);
            _sessionToken = CreateSessionToken();

            if (details is null)
            {
                _searchError = "Google no pudo resolver esa dirección.";
                return;
            }

            Address = details.FormattedAddress;
            _coordinateAddress = Address;
            await AddressChanged.InvokeAsync(Address);
            await OnPlaceSelected.InvokeAsync((Address, details.Latitude, details.Longitude));
        }
        catch
        {
            _searchError = "Google no pudo cargar la dirección seleccionada.";
        }
    }

    private static string CreateSessionToken() => Guid.NewGuid().ToString("N");
}
