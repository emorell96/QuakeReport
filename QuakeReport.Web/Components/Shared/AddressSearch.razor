@inject GooglePlacesService GooglePlaces

<MudAutocomplete T="GooglePlaceSuggestion"
                 Label="Dirección (opcional - busca para fijar la ubicación exacta)"
                 Value="_selectedSuggestion"
                 ValueChanged="OnSuggestionSelectedAsync"
                 Text="@Address"
                 TextChanged="OnAddressTypedAsync"
                 SearchFunc="SearchAddressesAsync"
                 ToStringFunc="FormatSuggestion"
                 MinCharacters="GooglePlacesService.MinimumSearchLength"
                 DebounceInterval="350"
                 MaxItems="5"
                 Strict="false"
                 CoerceText="true"
                 CoerceValue="false"
                 ResetValueOnEmptyText="true"
                 Clearable="true"
                 ShowProgressIndicator="true"
                 Adornment="Adornment.Start"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 Placeholder="Escribe al menos 4 caracteres..."
                 HelperText="Las sugerencias de Google aparecen después de 4 caracteres">
    <ItemTemplate Context="suggestion">
        <MudText Typo="Typo.body2">@suggestion.Description</MudText>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.body2" Class="pa-2">
            @(string.IsNullOrWhiteSpace(_searchError) ? "No se encontraron direcciones." : _searchError)
        </MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    private GooglePlaceSuggestion? _selectedSuggestion;
    private string? _searchError;
    private string _sessionToken = CreateSessionToken();

    [Parameter]
    public string? Address { get; set; }

    [Parameter]
    public EventCallback<string?> AddressChanged { get; set; }

    [Parameter]
    public double? Latitude { get; set; }

    [Parameter]
    public double? Longitude { get; set; }

    /// <summary>Fired when a place is picked from the dropdown, with its coordinates.</summary>
    [Parameter]
    public EventCallback<(string Address, double Latitude, double Longitude)> OnPlaceSelected { get; set; }

    private async Task<IEnumerable<GooglePlaceSuggestion>> SearchAddressesAsync(
        string? value,
        CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value)
            || value.Trim().Length < GooglePlacesService.MinimumSearchLength)
        {
            _searchError = null;
            return [];
        }

        try
        {
            _searchError = null;
            return await GooglePlaces.SearchAsync(
                value,
                Latitude,
                Longitude,
                _sessionToken,
                cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return [];
        }
        catch
        {
            _searchError = "La búsqueda de direcciones no está disponible en este momento.";
            return [];
        }
    }

    private async Task OnAddressTypedAsync(string? value)
    {
        Address = value;
        if (_selectedSuggestion is not null
            && !string.Equals(value, _selectedSuggestion.Description, StringComparison.Ordinal))
        {
            _selectedSuggestion = null;
        }

        await AddressChanged.InvokeAsync(value);
    }

    private async Task OnSuggestionSelectedAsync(GooglePlaceSuggestion? suggestion)
    {
        _selectedSuggestion = suggestion;
        if (suggestion is null)
        {
            return;
        }

        try
        {
            var details = await GooglePlaces.GetDetailsAsync(
                suggestion.PlaceId,
                _sessionToken,
                CancellationToken.None);
            _sessionToken = CreateSessionToken();

            if (details is null)
            {
                _searchError = "Google no pudo resolver esa dirección.";
                return;
            }

            Address = details.FormattedAddress;
            await AddressChanged.InvokeAsync(Address);
            await OnPlaceSelected.InvokeAsync((Address, details.Latitude, details.Longitude));
        }
        catch
        {
            _searchError = "Google no pudo cargar la dirección seleccionada.";
        }
    }

    private static string FormatSuggestion(GooglePlaceSuggestion? suggestion) =>
        suggestion?.Description ?? string.Empty;

    private static string CreateSessionToken() => Guid.NewGuid().ToString("N");
}
