<MudStack Row="true"
          Justify="@Justify"
          AlignItems="@AlignItems"
          Class="@($"mb-4 responsive-row {Class}".Trim())">
    <MudText Typo="@Typo">@Title</MudText>
    @if (Actions is not null)
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Class="responsive-actions">
            @Actions
        </MudStack>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public Typo Typo { get; set; } = Typo.h4;
    [Parameter] public string? Class { get; set; }
    [Parameter] public Justify Justify { get; set; } = Justify.SpaceBetween;
    [Parameter] public AlignItems AlignItems { get; set; } = AlignItems.Center;
}
