@inherits LayoutComponentBase
@implements IDisposable
@inject IThemeService ThemeService

<style>
    .brand-container {
        height: 100%;
        align-self: stretch;
        display: flex;
        align-items: center;
    }

    .brand-link {
        display: flex;
        align-items: center;
        height: 100%;
    }

    .brand-image {
        max-height: 100%;
        width: auto;
        display: block;
    }
</style>

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" IsDarkModeChanged="OnDarkModeChanged" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Abrir menú de navegación" OnClick="ToggleDrawer" />
        
        <div class="brand-container">
                <a href="/" class="brand-link" aria-label="Ir al inicio de Terremoto.com.co">
                @if (_isDarkMode)
                {
                    <MudImage Src="bar-icon-dark-theme.png" Class="brand-image" ObjectFit="ObjectFit.ScaleDown" />
                }
                else
                {
                    <MudImage Src="bar-icon-light-theme.png" Class="brand-image" ObjectFit="ObjectFit.ScaleDown" />
                }
                </a>
            </div>
            
            @* <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudImage Src="favicon.png" Alt="Logo de Terremoto.com.co" Height="30" ObjectFit="ObjectFit.ScaleDown" />
                <MudText Typo="Typo.h6">Terremoto.com.co</MudText>
            </MudStack> *@
        
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       aria-label="@(_isDarkMode ? "Cambiar a tema claro" : "Cambiar a tema oscuro")"
                       OnClick="ToggleThemeAsync" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Navegación</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.List" OnClick="CloseDrawer">Reportes</MudNavLink>
            <MudNavLink Href="/mapa" Icon="@Icons.Material.Filled.Map" OnClick="CloseDrawer">Mapa</MudNavLink>
            <MudNavLink Href="/report/new" Icon="@Icons.Material.Filled.AddAlert" OnClick="CloseDrawer">Reportar daño</MudNavLink>
            <MudNavLink Href="/missing-people" Icon="@Icons.Material.Filled.PersonSearch" OnClick="CloseDrawer">Personas extraviadas</MudNavLink>
            <MudNavLink Href="/collection-points" Icon="@Icons.Material.Filled.VolunteerActivism" OnClick="CloseDrawer">Centros de acopio</MudNavLink>
            <MudNavLink Href="/refugios" Icon="@Icons.Material.Filled.HomeWork" OnClick="CloseDrawer">Refugios</MudNavLink>
            <MudNavLink Href="/ayuda" Icon="@Icons.Material.Filled.Sos" OnClick="CloseDrawer">Solicitudes de ayuda</MudNavLink>
            <MudNavLink Href="/donacion-sangre" Icon="@Icons.Material.Filled.Bloodtype" OnClick="CloseDrawer">Donación de sangre</MudNavLink>
            <MudNavLink Href="/missing-people/manage" Icon="@Icons.Material.Filled.AdminPanelSettings" OnClick="CloseDrawer">Administrar registro</MudNavLink>
            <MudNavLink Href="/about" Icon="@Icons.Material.Filled.Info" OnClick="CloseDrawer">Acerca de</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="site-main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="site-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">Cerrar</a>
</div>

@code {
    private bool _drawerOpen;
    private bool _isDarkMode;
    private bool _themeLoaded;
    private readonly MudTheme _theme = new();
    private EventCallback<Theme> _themeChangedCallback;

    protected override void OnInitialized()
    {
        _themeChangedCallback = EventCallback.Factory.Create<Theme>(this, ApplyThemeAsync);
        ThemeService.ThemeChangedCallbacks.Add(_themeChangedCallback);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ApplyThemeAsync(await ThemeService.GetCurrentThemeAsync());
        _themeLoaded = true;
        StateHasChanged();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void CloseDrawer() => _drawerOpen = false;

    private async Task ToggleThemeAsync()
    {
        if (!_themeLoaded)
        {
            return;
        }

        await ThemeService.SetCurrentThemeAsync(_isDarkMode ? Theme.Light : Theme.Dark);
    }

    private Task OnDarkModeChanged(bool isDarkMode)
        => _themeLoaded && isDarkMode != _isDarkMode
            ? ThemeService.SetCurrentThemeAsync(isDarkMode ? Theme.Dark : Theme.Light)
            : Task.CompletedTask;

    private Task ApplyThemeAsync(Theme theme)
    {
        _isDarkMode = theme == Theme.Dark;
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.ThemeChangedCallbacks.Remove(_themeChangedCallback);
    }
}
