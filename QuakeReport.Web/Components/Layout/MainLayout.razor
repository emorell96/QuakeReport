@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
        <MudText Typo="Typo.h6">QuakeReport</MudText>
        <MudSpacer />
        <MudButton Href="/" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.List">Reports</MudButton>
        <MudButton Href="/report/new" Color="Color.Inherit" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AddAlert">
            Report Damage
        </MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
