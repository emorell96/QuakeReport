@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
        <a href="/" class="brand-link">
            <MudText Typo="Typo.h6">Terremoto.com.co</MudText>
        </a>
        <MudSpacer />
        <MudButton Href="/" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.List">Reportes</MudButton>
        <MudButton Href="/report/new" Color="Color.Inherit" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AddAlert">
            Reportar Daño
        </MudButton>
        <MudButton Href="/missing-people" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.PersonSearch">Personas extraviadas</MudButton>
        <MudButton Href="/collection-points" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.VolunteerActivism">Centros de acopio</MudButton>
        <MudButton Href="/refugios" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.HomeWork">Refugios</MudButton>
        <MudButton Href="/missing-people/manage" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AdminPanelSettings">Administrar registro</MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>
