@page "/ayuda/{Id:guid}"
@inject QuakeReportApiClient ApiClient
@inject ShareService Share
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Solicitud de ayuda - Terremoto.com.co</PageTitle>
@if (_request is null) { <MudProgressCircular Indeterminate="true" /> } else {
<MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4"><MudButton Href="/ayuda" StartIcon="@Icons.Material.Filled.ArrowBack">Volver</MudButton><MudButton StartIcon="@Icons.Material.Filled.Share" OnClick="ShareAsync">Compartir</MudButton></MudStack>
<MudPaper Class="pa-4"><MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center"><MudText Typo="Typo.h5">@_request.Title</MudText><MudChip T="string" Color="@PriorityColor(_request.Priority)">@_request.Priority</MudChip><MudChip T="string">@_request.Status</MudChip>@if(_request.ModerationStatus==HelpRequestModerationStatus.Pending){<MudChip T="string" Color="Color.Warning">No verificado</MudChip>}</MudStack><MudText Typo="Typo.subtitle1">@_request.RequesterName @(_request.OrganizationName is null?"":$"· {_request.OrganizationName}")</MudText><MudText Class="mt-3">@_request.NeedDetails</MudText>@if(!string.IsNullOrWhiteSpace(_request.Instructions)){<MudText Class="mt-2"><strong>Instrucciones:</strong> @_request.Instructions</MudText>}<MudText Class="mt-2">📍 @_request.Address</MudText><MudButton Href="@_request.GoogleMapsUrl" Target="_blank" Class="mt-2">Abrir en Google Maps</MudButton><MudText Class="mt-2">Contacto público: @_request.PublicPhone @(_request.PublicWhatsApp is null?"":$" · WhatsApp {_request.PublicWhatsApp}")</MudText>@if(_request.NeededBy is not null){<MudText>Necesitado antes de: @_request.NeededBy.Value.ToLocalTime().ToString("f")</MudText>}</MudPaper>
<MudPaper Class="pa-4 mt-4"><MudText Typo="Typo.h6">Comentarios</MudText>@foreach(var c in _request.Comments){<MudPaper Class="pa-3 my-2" Outlined="true"><MudText Typo="Typo.body2">@(c.DisplayName??"Anónimo") · @c.CreatedAt.ToLocalTime().ToString("g")</MudText><MudText>@c.Message</MudText></MudPaper>}@if(_request.Status==HelpRequestStatus.Resolved){<MudAlert Severity="Severity.Info">Esta solicitud está resuelta y no acepta nuevos comentarios.</MudAlert>}else{<MudTextField Label="Mensaje*" Lines="3" @bind-Value="_message" Required="true" /><MudTextField Label="Nombre (opcional)" @bind-Value="_displayName" /><Turnstile SiteKey="@Configuration["Turnstile:SiteKey"]" @bind-Token="_turnstile" /><MudButton Class="mt-3" Variant="Variant.Filled" OnClick="AddCommentAsync">Enviar comentario</MudButton>}</MudPaper>}
@if(_error is not null){<MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>}
@code { [Parameter] public Guid Id{get;set;} private HelpRequestResponse? _request; private string? _message,_displayName,_turnstile,_error; protected override async Task OnParametersSetAsync()=>_request=await ApiClient.GetHelpRequestAsync(Id); private async Task AddCommentAsync(){try{await ApiClient.CreateHelpRequestCommentAsync(Id,new(_displayName,_message??"",_turnstile??""));_request=await ApiClient.GetHelpRequestAsync(Id);}catch(Exception e){_error=e.Message;}} private Task ShareAsync()=>Share.ShareAsync(_request!.Title,_request.NeedDetails,Navigation.Uri); private static Color PriorityColor(HelpRequestPriority p)=>p switch{HelpRequestPriority.Critical=>Color.Error,HelpRequestPriority.High=>Color.Warning,_=>Color.Info}; }
