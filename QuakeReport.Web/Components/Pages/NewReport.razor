@page "/report/new"
@inject QuakeReportApiClient ApiClient
@inject GeolocationService Geolocation
@inject GooglePlacesService GooglePlaces
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Reportar Daño</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Reportar Daño</MudText>

<MudForm @ref="_form" Model="_model" Validation="_validator.ValidateValue">
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Ubicación</MudText>
        @switch (_locationState)
        {
            case LocationState.Loading:
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                    <MudText>Obteniendo tu ubicación... revisa si hay un aviso de permiso del navegador (suele aparecer cerca de la barra de direcciones).</MudText>
                </MudStack>
                break;
            case LocationState.Failed:
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    @_locationErrorMessage Se requiere la ubicación para enviar un reporte.
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RequestLocationAsync">Reintentar</MudButton>
                break;
            case LocationState.Success:
                <MudAlert Severity="Severity.Success" Class="mb-2">
                    Ubicación capturada (@_model.Latitude?.ToString("0.0000"), @_model.Longitude?.ToString("0.0000"))
                </MudAlert>
                break;
        }

        <AddressSearch @bind-Address="_model.Address"
                       Latitude="_model.Latitude" Longitude="_model.Longitude"
                       For="@(() => _model.Address)" OnPlaceSelected="OnPlaceSelected"
                       OnCoordinatesCleared="ClearCoordinates" />
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudTextField T="string" Label="Descripción" @bind-Value="_model.Description"
                      For="@(() => _model.Description)" Lines="3" Class="mb-4" />
        <MudSelect T="SeverityLevel" Label="Gravedad" @bind-Value="_model.Severity"
                   For="@(() => _model.Severity)" Class="mb-4">
            @foreach (var level in Enum.GetValues<SeverityLevel>())
            {
                <MudSelectItem T="SeverityLevel" Value="level">@level.ToDisplayString()</MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.body2" Class="mb-2">¿Qué daños observas? (selecciona todos los que apliquen)</MudText>
        <MudGrid Class="mb-4">
            @foreach (var sign in Enum.GetValues<DamageSign>())
            {
                if (sign != DamageSign.None)
                {
                    <MudItem xs="6" sm="4">
                        <MudCheckBox T="bool" Value="@_model.DamageSigns.HasFlag(sign)"
                                     ValueChanged="@(value => ToggleSign(sign, value))"
                                     Label="@sign.ToDisplayString()" />
                    </MudItem>
                }
            }
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="StructureType?" Label="Tipo de estructura (opcional)"
                           @bind-Value="_model.StructureType" For="@(() => _model.StructureType)" Clearable="true">
                    @foreach (var type in Enum.GetValues<StructureType>())
                    {
                        <MudSelectItem T="StructureType?" Value="type">@type.ToDisplayString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="StructureSize?" Label="Tamaño de la estructura (opcional)"
                           @bind-Value="_model.StructureSize" For="@(() => _model.StructureSize)" Clearable="true">
                    @foreach (var size in Enum.GetValues<StructureSize>())
                    {
                        <MudSelectItem T="StructureSize?" Value="size">@size.ToDisplayString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Fotos y Videos</MudText>
        <InputFile multiple accept="image/*,video/*" OnChange="OnFilesSelected" />
        @if (_model.MediaFiles.Count > 0)
        {
            <MudList T="string" Class="mt-2">
                @foreach (var file in _model.MediaFiles)
                {
                    <MudListItem T="string" Icon="@(file.ContentType.StartsWith("video/") ? Icons.Material.Filled.Videocam : Icons.Material.Filled.Image)">
                        @file.Name (@((file.Size / 1024.0 / 1024.0).ToString("0.0")) MB)
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>

    <PrivacyConsent @bind-Value="_model.PrivacyConsent" For="@(() => _model.PrivacyConsent)" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
               Disabled="@(_submitting || _locationState != LocationState.Success)" OnClick="SubmitAsync">
        @if (_submitting)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            <span>Enviando...</span>
        }
        else
        {
            <span>Enviar Reporte</span>
        }
    </MudButton>
</MudForm>
