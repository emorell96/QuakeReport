@page "/donacion-sangre/nuevo"
@inject QuakeReportApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>Registrar donación de sangre - Terremoto.com.co</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Registrar centro de donación de sangre</MudText>
<MudAlert Severity="Severity.Warning" Class="mb-4">La información será pública y aparecerá como No verificada hasta que la revise un moderador. Confirma la disponibilidad directamente con el centro.</MudAlert>

<MudForm @ref="_form" Model="_model" Validation="_validator.ValidateValue">
    <MudPaper Class="pa-4">
        <MudTextField Label="Nombre del centro o campaña*" @bind-Value="_model.Name" For="@(() => _model.Name)" />
        <MudTextField Label="Organización" @bind-Value="_model.OrganizationName" For="@(() => _model.OrganizationName)" />
        <MudSelect T="BloodDonationCenterType" Label="Tipo de registro" @bind-Value="_model.CenterType" For="@(() => _model.CenterType)">
            <MudSelectItem Value="BloodDonationCenterType.PermanentSite">Sede permanente</MudSelectItem>
            <MudSelectItem Value="BloodDonationCenterType.TemporaryCampaign">Campaña temporal</MudSelectItem>
        </MudSelect>
        <AddressSearch Label="Dirección" @bind-Address="_model.Address"
                       Latitude="_model.Latitude" Longitude="_model.Longitude"
                       For="@(() => _model.Address)" OnPlaceSelected="OnPlaceSelected"
                       OnCoordinatesCleared="ClearCoordinates"
                       Required="true"/>
        <MudTextField Label="Descripción" Lines="3" @bind-Value="_model.Description" For="@(() => _model.Description)" />
        <MudTextField Label="Horarios e instrucciones para donar" Lines="4" @bind-Value="_model.OperatingInstructions" For="@(() => _model.OperatingInstructions)" Required="true" />
        <MudTextField Label="Resumen de necesidades" Lines="3" @bind-Value="_model.NeedsSummary" For="@(() => _model.NeedsSummary)" />
        @*TODO: Make this a mudfield to integrate with the form validation*@

        <MudText Typo="Typo.subtitle1" Class="mt-3">Grupos sanguíneos que necesitan*</MudText>
        <MudGrid>
            @foreach (var item in BloodTypes)
            {
                <MudItem xs="6" sm="3">
                    <MudCheckBox T="bool" Label="@item.Label" Value="@_model.BloodTypes.HasFlag(item.Value)" ValueChanged="@(value => ToggleBlood(item.Value, value))" />
                </MudItem>
            }
        </MudGrid>

        
        <MudText Typo="Typo.subtitle1" Class="mt-3">Componentes que necesitan*</MudText>
        <MudGrid>
            @foreach (var item in Components)
            {
                <MudItem xs="12" sm="6">
                    <MudCheckBox T="bool" Label="@item.Label" Value="@_model.Components.HasFlag(item.Value)" ValueChanged="@(value => ToggleComponent(item.Value, value))" />
                </MudItem>
            }
        </MudGrid>
        <MudTextField Label="Teléfono público" @bind-Value="_model.Phone" For="@(() => _model.Phone)" />
        <MudTextField Label="WhatsApp público" @bind-Value="_model.WhatsApp" For="@(() => _model.WhatsApp)" />
        <MudTextField Label="Correo público" @bind-Value="_model.Email" For="@(() => _model.Email)" />
        <MudDatePicker Label="Inicio de campaña" @bind-Date="_model.StartsAt" For="@(() => _model.StartsAt)" />
        <MudDatePicker Label="Fin de campaña" @bind-Date="_model.EndsAt" For="@(() => _model.EndsAt)" />
        <PrivacyConsent @bind-Value="_model.PrivacyConsent" For="@(() => _model.PrivacyConsent)" />
        <Turnstile SiteKey="@Configuration["Turnstile:SiteKey"]" @bind-Token="_model.TurnstileToken" />
        
        @if (_code is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4">Guarda este código de administración; solo se muestra una vez: <strong>@_code</strong></MudAlert>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }
        <MudButton Class="mt-4 responsive-primary-action" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Registrar</MudButton>
    </MudPaper>
</MudForm>
