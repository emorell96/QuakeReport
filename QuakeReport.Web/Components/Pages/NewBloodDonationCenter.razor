@page "/donacion-sangre/nuevo"
@inject QuakeReportApiClient ApiClient
@inject IConfiguration Configuration
<PageTitle>Registrar donación de sangre - Terremoto.com.co</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Registrar centro de donación de sangre</MudText>
<MudAlert Severity="Severity.Warning" Class="mb-4">La información será pública y aparecerá como No verificada hasta que la revise un moderador. Confirma la disponibilidad directamente con el centro.</MudAlert>
<MudPaper Class="pa-4">
<MudTextField Label="Nombre del centro o campaña*" @bind-Value="_name" Required="true"/><MudTextField Label="Organización" @bind-Value="_organization"/><MudSelect T="BloodDonationCenterType" Label="Tipo de registro" @bind-Value="_type"><MudSelectItem Value="BloodDonationCenterType.PermanentSite">Sede permanente</MudSelectItem><MudSelectItem Value="BloodDonationCenterType.TemporaryCampaign">Campaña temporal</MudSelectItem></MudSelect>
<AddressSearch @bind-Address="_address" Latitude="_latitude" Longitude="_longitude" OnPlaceSelected="OnPlaceSelected" OnCoordinatesCleared="ClearCoordinates"/><MudTextField Label="Descripción" Lines="3" @bind-Value="_description"/><MudTextField Label="Horarios e instrucciones para donar*" Lines="4" @bind-Value="_instructions" Required="true"/><MudTextField Label="Resumen de necesidades*" Lines="3" @bind-Value="_needs" Required="true"/>
<MudText Typo="Typo.subtitle1" Class="mt-3">Grupos sanguíneos que necesitan*</MudText><MudGrid>@foreach(var item in BloodTypes){<MudItem xs="6" sm="3"><MudCheckBox T="bool" Label="@item.Label" Value="@_bloodTypes.HasFlag(item.Value)" ValueChanged="@(v=>ToggleBlood(item.Value,v))"/></MudItem>}</MudGrid>
<MudText Typo="Typo.subtitle1" Class="mt-3">Componentes que necesitan*</MudText><MudGrid>@foreach(var item in Components){<MudItem xs="12" sm="6"><MudCheckBox T="bool" Label="@item.Label" Value="@_components.HasFlag(item.Value)" ValueChanged="@(v=>ToggleComponent(item.Value,v))"/></MudItem>}</MudGrid>
<MudTextField Label="Teléfono público*" @bind-Value="_phone" Required="true"/><MudTextField Label="WhatsApp público" @bind-Value="_whatsapp"/><MudTextField Label="Correo público" @bind-Value="_email"/><MudDatePicker Label="Inicio de campaña" @bind-Date="_starts"/><MudDatePicker Label="Fin de campaña" @bind-Date="_ends"/><PrivacyConsent @bind-Value="_consent"/><Turnstile SiteKey="@Configuration["Turnstile:SiteKey"]" @bind-Token="_turnstile"/><MudButton Class="mt-4 responsive-primary-action" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">REGISTRAR CENTRO</MudButton>
@if(_code is not null){<MudAlert Severity="Severity.Warning" Class="mt-4">Guarda este código de administración; solo se muestra una vez: <strong>@_code</strong></MudAlert>}@if(_error is not null){<MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>}
</MudPaper>
@code {
private record Choice<T>(T Value,string Label); private readonly Choice<BloodTypeFlags>[] BloodTypes=[new(BloodTypeFlags.APositive,"A+"),new(BloodTypeFlags.ANegative,"A−"),new(BloodTypeFlags.BPositive,"B+"),new(BloodTypeFlags.BNegative,"B−"),new(BloodTypeFlags.ABPositive,"AB+"),new(BloodTypeFlags.ABNegative,"AB−"),new(BloodTypeFlags.OPositive,"O+"),new(BloodTypeFlags.ONegative,"O−"),new(BloodTypeFlags.Unknown,"No sé")]; private readonly Choice<BloodComponentFlags>[] Components=[new(BloodComponentFlags.WholeBlood,"Sangre total"),new(BloodComponentFlags.RedBloodCells,"Glóbulos rojos"),new(BloodComponentFlags.Plasma,"Plasma"),new(BloodComponentFlags.Platelets,"Plaquetas"),new(BloodComponentFlags.Unknown,"No sé")];
private string? _name,_organization,_address,_description,_instructions,_needs,_phone,_whatsapp,_email,_turnstile,_code,_error; private double? _latitude,_longitude; private DateTime? _starts,_ends; private bool _consent,_saving; private BloodDonationCenterType _type=BloodDonationCenterType.PermanentSite; private BloodTypeFlags _bloodTypes; private BloodComponentFlags _components;
private void ToggleBlood(BloodTypeFlags value,bool selected)=>_bloodTypes=selected?_bloodTypes|value:_bloodTypes&~value; private void ToggleComponent(BloodComponentFlags value,bool selected)=>_components=selected?_components|value:_components&~value; private void OnPlaceSelected((string Address,double Latitude,double Longitude) value){_address=value.Address;_latitude=value.Latitude;_longitude=value.Longitude;} private void ClearCoordinates(){_latitude=null;_longitude=null;}
private async Task SubmitAsync(){_saving=true;_error=null;try{if(!_consent)throw new InvalidOperationException("Debes aceptar la política de tratamiento de datos.");DateTimeOffset? starts=_starts is null?null:new(DateTime.SpecifyKind(_starts.Value,DateTimeKind.Utc));DateTimeOffset? ends=_ends is null?null:new(DateTime.SpecifyKind(_ends.Value,DateTimeKind.Utc));var r=await ApiClient.CreateBloodDonationCenterAsync(new(_name??"",_organization,_address??"",_latitude,_longitude,_description,_instructions??"",_needs??"",_phone??"",_whatsapp,_email,_type,_bloodTypes,_components,starts,ends,_consent,_turnstile??""));_code=r.ManagementCode;}catch(Exception e){_error=e.Message;}finally{_saving=false;}}
}
