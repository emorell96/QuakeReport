@page "/donacion-sangre/admin"
@inject QuakeReportApiClient ApiClient
@inject AuthenticationStateProvider Auth
<PageTitle>Moderar donación de sangre - Terremoto.com.co</PageTitle><MudText Typo="Typo.h5">Moderar centros de donación</MudText><MudButton Class="my-4" OnClick="LoadAsync">Actualizar</MudButton>@if(_error is not null){<MudAlert Severity="Severity.Error">@_error</MudAlert>}<MudStack Spacing="2">@foreach(var center in _items){<MudPaper Class="pa-4"><MudText Typo="Typo.h6">@center.Name</MudText><MudText>@center.Address · @BloodDonationDisplay.Type(center.CenterType)</MudText><MudText>Grupos: @BloodDonationDisplay.BloodTypes(center.BloodTypes)</MudText><MudButton Color="Color.Success" OnClick="@(()=>ModerateAsync(center.Id,BloodDonationModerationStatus.Approved))">Aprobar</MudButton><MudButton Color="Color.Error" OnClick="@(()=>ModerateAsync(center.Id,BloodDonationModerationStatus.Rejected))">Rechazar</MudButton></MudPaper>}</MudStack>
@code{private IReadOnlyList<BloodDonationCenterSummaryResponse> _items=[];private string? _error;protected override async Task OnInitializedAsync()=>await LoadAsync();private async Task LoadAsync(){try{_items=(await ApiClient.GetPendingBloodDonationCentersAsync()).Results.ToList();}catch(Exception e){_error=e.Message;}}private async Task ModerateAsync(Guid id,BloodDonationModerationStatus status){try{var user=await Auth.GetAuthenticationStateAsync();await ApiClient.ModerateBloodDonationCenterAsync(id,status,user.User.Identity?.Name);await LoadAsync();}catch(Exception e){_error=e.Message;}}}
