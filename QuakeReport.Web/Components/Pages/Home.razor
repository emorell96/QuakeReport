@page "/"
@inject QuakeReportApiClient ApiClient
@implements IDisposable

<PageTitle>Terremoto.com.co</PageTitle>

@if (_earthquake is not null)
{
    <MudPaper Class="pa-4 mb-6" Elevation="2">
        <MudText Typo="Typo.h5">@_earthquake.Name</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Magnitud @_earthquake.Magnitude.ToString("0.0") &middot; @_earthquake.OccurredAt.ToLocalTime().ToString("f")
        </MudText>
    </MudPaper>
}

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4 responsive-row">
    <MudText Typo="Typo.h6">Refugios</MudText>
    <MudButton Href="/refugios" Variant="Variant.Outlined">Ver todos</MudButton>
</MudStack>
@if (_shelters.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-6">No hay refugios abiertos publicados.</MudAlert>
}
else
{
    <MudGrid Class="mb-6">
        @foreach (var shelter in _shelters)
        {
            <MudItem xs="12" sm="6" md="4"><MudCard Class="h-100"><MudCardContent>
                <MudStack Row="true"><MudText Typo="Typo.h6">@shelter.Name</MudText>@if (shelter.ModerationStatus == ShelterModerationStatus.Pending) { <MudChip T="string" Color="Color.Warning" Size="Size.Small">No verificado</MudChip> }</MudStack>
                <MudText>@shelter.Address</MudText><MudText Typo="Typo.body2">@shelter.Description</MudText><MudButton Href="@($"/refugios/{shelter.Id}")" Size="Size.Small" Class="mt-2">Detalles</MudButton>
            </MudCardContent></MudCard></MudItem>
        }
    </MudGrid>
}

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4 responsive-row">
    <MudText Typo="Typo.h6">Personas extraviadas</MudText>
    <MudButton Href="/missing-people" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonSearch">Ver todas</MudButton>
</MudStack>

@if (_missingPeople.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-6">No hay personas extraviadas registradas.</MudAlert>
}
else
{
    <MudGrid Class="mb-6" Spacing="2">
        @foreach (var person in _missingPeople)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="h-100" @onclick="() => NavigateToMissingPerson(person.Id)" Style="cursor:pointer">
                    @if (!string.IsNullOrWhiteSpace(person.PhotoUrl)) { <MudCardMedia Image="@person.PhotoUrl" Height="180" /> }
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@person.FullName</MudText>
                        @if (person.IdentificationLastFour is not null) { <MudText Typo="Typo.body2">Documento terminado en @person.IdentificationLastFour</MudText> }
                        <MudText Typo="Typo.body2">Último avistamiento: @person.LastSeenAt.ToLocalTime().ToString("g")</MudText>
                        <MudText Typo="Typo.body2">@(person.PrimaryAddress ?? "Ubicación no especificada")</MudText>
                        <MudButton Href="/missing-people/manage" @onclick:stopPropagation="true" Size="Size.Small" Class="mt-2">Editar con código</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4 responsive-row">
    <MudText Typo="Typo.h6">Centros de acopio</MudText>
    <MudButton Href="/collection-points" Variant="Variant.Outlined">Ver todos</MudButton>
</MudStack>
@if (_collectionPoints.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-6">No hay centros de acopio abiertos publicados.</MudAlert>
}
else
{
    <MudGrid Class="mb-6">
        @foreach (var point in _collectionPoints)
        {
            <MudItem xs="12" sm="6" md="4"><MudCard Class="h-100"><MudCardContent><MudText Typo="Typo.h6">@point.Name</MudText><MudText>@point.Address</MudText><MudText Typo="Typo.body2"><strong>Necesidades:</strong> @point.NeedsSummary</MudText><MudButton Href="@($"/collection-points/{point.Id}")" Size="Size.Small" Class="mt-2">Detalles</MudButton></MudCardContent></MudCard></MudItem>
        }
    </MudGrid>
}

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4 responsive-row">
    <MudText Typo="Typo.h6">Reportes de Daños</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">
        Actualizar
    </MudButton>
</MudStack>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6">
            <MudSelect T="SeverityLevel?" Label="Filtrar por gravedad" Value="_severityFilter" ValueChanged="OnSeverityChangedAsync" Clearable="true">
                <MudSelectItem T="SeverityLevel?" Value="@((SeverityLevel?)null)">Todas las gravedades</MudSelectItem>
                @foreach (var severity in Enum.GetValues<SeverityLevel>().OrderByDescending(value => value))
                {
                    <MudSelectItem T="SeverityLevel?" Value="severity">@severity.ToDisplayString()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="ReportSortOption" Label="Ordenar por" Value="_sortOption" ValueChanged="OnSortChangedAsync">
                <MudSelectItem Value="ReportSortOption.Newest">Más recientes</MudSelectItem>
                <MudSelectItem Value="ReportSortOption.Oldest">Más antiguos</MudSelectItem>
                <MudSelectItem Value="ReportSortOption.HighestSeverity">Mayor gravedad</MudSelectItem>
                <MudSelectItem Value="ReportSortOption.LowestSeverity">Menor gravedad</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (_totalCount == 0 && _severityFilter is null)
{
    <MudAlert Severity="Severity.Info">Aún no hay reportes de daños.</MudAlert>
}
else if (_totalCount == 0)
{
    <MudAlert Severity="Severity.Info">No hay reportes que coincidan con el filtro seleccionado.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        @foreach (var report in _reports)
        {
            <MudPaper Class="pa-4" Elevation="1" @onclick="() => NavigateToReport(report.Id)" Style="cursor:pointer">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="responsive-row">
                    <div>
                        <MudChip T="string" Color="@DisplayHelpers.SeverityColor(report.Severity)" Size="Size.Small">
                            @report.Severity.ToDisplayString()
                        </MudChip>
                        @if (report.StructureType is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @report.StructureType.Value.ToDisplayString()@(report.StructureSize is not null ? $" ({report.StructureSize.Value.ToDisplayString()})" : "")
                            </MudChip>
                        }
                        <MudText Typo="Typo.body1" Class="mt-2">@report.Description</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                            @foreach (var sign in report.DamageSigns.Split())
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@sign.ToDisplayString()</MudChip>
                            }
                        </MudStack>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@report.CreatedAt.ToLocalTime().ToString("g")</MudText>
                </MudStack>
            </MudPaper>
        }
    </MudStack>

    @if (_totalPages > 1)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-6">
            <MudPagination Count="_totalPages" Selected="_page" SelectedChanged="OnPageChangedAsync" />
        </MudStack>
    }
}

@code {
    private const int PageSize = 20;

    private IReadOnlyList<DamageReportSummaryResponse> _reports = [];
    private IReadOnlyList<CollectionPointSummaryResponse> _collectionPoints = [];
    private IReadOnlyList<ShelterSummaryResponse> _shelters = [];
    private IReadOnlyList<MissingPersonSummaryResponse> _missingPeople = [];
    private EarthquakeResponse? _earthquake;
    private bool _loading = true;
    private SeverityLevel? _severityFilter;
    private ReportSortOption _sortOption = ReportSortOption.Newest;
    private int _page = 1;
    private int _totalCount;
    private int _totalPages;
    private CancellationTokenSource? _loadCancellation;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var cancellation = new CancellationTokenSource();
        var previousCancellation = Interlocked.Exchange(ref _loadCancellation, cancellation);
        previousCancellation?.Cancel();
        previousCancellation?.Dispose();

        _loading = true;
        try
        {
            var earthquakeTask = ApiClient.GetActiveEarthquakeAsync(cancellation.Token);
            var reportsTask = ApiClient.GetReportsAsync(
                _page,
                PageSize,
                _severityFilter,
                _sortOption,
                cancellation.Token);
            var missingPeopleTask = ApiClient.GetMissingPeopleAsync(page: 1, pageSize: 6, cancellationToken: cancellation.Token);
            var collectionPointsTask = ApiClient.GetCollectionPointsAsync(page: 1, pageSize: 6, cancellationToken: cancellation.Token);
            var sheltersTask = ApiClient.GetSheltersAsync(operationalStatus: ShelterOperationalStatus.Open, page: 1, pageSize: 6, cancellationToken: cancellation.Token);

            await Task.WhenAll(earthquakeTask, reportsTask, missingPeopleTask, sheltersTask, collectionPointsTask);
            if (!ReferenceEquals(_loadCancellation, cancellation))
            {
                return;
            }

            _earthquake = await earthquakeTask;
            var response = await reportsTask;
            _reports = response.Items;
            _totalCount = response.TotalCount;
            _totalPages = response.TotalPages;
            _missingPeople = (await missingPeopleTask).Items;
            _shelters = (await sheltersTask).Items;
            _collectionPoints = (await collectionPointsTask).Items;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_loadCancellation, cancellation))
            {
                _loading = false;
            }
        }
    }

    private async Task OnSeverityChangedAsync(SeverityLevel? severity)
    {
        _severityFilter = severity;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSortChangedAsync(ReportSortOption sort)
    {
        _sortOption = sort;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private void NavigateToReport(Guid id) => Navigation.NavigateTo($"/report/{id}");
    private void NavigateToMissingPerson(Guid id) => Navigation.NavigateTo($"/missing-people/{id}");

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
