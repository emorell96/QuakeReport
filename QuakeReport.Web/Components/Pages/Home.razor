@page "/"
@inject QuakeReportApiClient ApiClient
@inject GeolocationService Geolocation
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Terremoto.com.co</PageTitle>

<Explanation />

@if (_earthquake is not null)
{
    <MudPaper Class="pa-4 mb-6" Elevation="2">
        <MudText Typo="Typo.h5">@_earthquake.Name</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Magnitud @_earthquake.Magnitude.ToString("0.0") &middot; @_earthquake.OccurredAt.ToLocalTime().ToString("f")
        </MudText>
    </MudPaper>
}

<HomeCardSection TItem="HelpRequestSummaryResponse"
                 Title="Solicitudes de ayuda"
                 TitleTypo="Typo.h4"
                 Items="_helpRequests"
                 Loading="_loading"
                 EmptyText="No hay solicitudes de ayuda activas publicadas.">
    <HeaderActions>
        <MudButton Href="/ayuda/nueva" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Publicar solicitud</MudButton>
        <MudButton Href="/ayuda" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sos">Ver todas</MudButton>
    </HeaderActions>
    <ItemTemplate Context="request">
        <MudCard Class="h-100">
            <MudCardContent>
                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">@request.Title</MudText>
                    <MudChip T="string" Color="@HelpPriorityColor(request.Priority)" Size="Size.Small">@request.Priority</MudChip>
                </MudStack>
                @if (request.ModerationStatus == HelpRequestModerationStatus.Pending)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">No verificado</MudChip>
                }
                <MudText Typo="Typo.body2">@request.RequesterName Â· @request.Address</MudText>
                <MudText Class="mt-2">@request.NeedDetails</MudText>
                
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="@($"/ayuda/{request.Id}")" Size="Size.Small" Class="mt-2">Ver detalles</MudButton>
                <MudButton Href="@request.GoogleMapsUrl" Target="_blank" Class="mt-3">Abrir en Google Maps</MudButton>
            </MudCardActions>
        </MudCard>
    </ItemTemplate>
</HomeCardSection>

<HomeCardSection TItem="MissingPersonSummaryResponse"
                 Title="Personas extraviadas"
                 Items="_missingPeople"
                 Loading="_loading"
                 EmptyText="No hay personas extraviadas registradas.">
    <HeaderActions>
        <MudButton Href="/missing-people/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">Registrar persona</MudButton>
        <MudButton Href="/missing-people" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonSearch">Ver todas</MudButton>
    </HeaderActions>
    <ItemTemplate Context="person">
        <MudCard Class="h-100" @onclick="() => NavigateToMissingPerson(person.Id)" Style="cursor:pointer">
            @if (!string.IsNullOrWhiteSpace(person.PhotoUrl))
            {
                <MudCardMedia Image="@person.PhotoUrl" Height="180" />
            }
            <MudCardContent>
                <MudText Typo="Typo.h6">@person.FullName</MudText>
                @if (person.IdentificationLastFour is not null)
                {
                    <MudText Typo="Typo.body2">Documento terminado en @person.IdentificationLastFour</MudText>
                }
                <MudText Typo="Typo.body2">Último avistamiento: @person.LastSeenAt.ToLocalTime().ToString("g")</MudText>
                <MudText Typo="Typo.body2">@(person.PrimaryAddress ?? "Ubicación no especificada")</MudText>

            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/missing-people/manage" @onclick:stopPropagation="true" Size="Size.Small" Class="mt-2">Editar con código</MudButton>
            </MudCardActions>
        </MudCard>
    </ItemTemplate>
    <FooterActions>
        <MudButton Href="/missing-people" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonSearch">Ver todas</MudButton>
    </FooterActions>
</HomeCardSection>

<HomeCardSection TItem="BloodDonationCenterSummaryResponse"
                 Title="Donación de sangre"
                 Items="_bloodDonationCenters"
                 Loading="_loading"
                 EmptyText="No hay centros de donación de sangre abiertos publicados.">
    <HeaderActions>
        <MudButton Href="/donacion-sangre/nuevo" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Bloodtype">Registrar centro de donación de sangre</MudButton>
        <MudButton Href="/donacion-sangre" Variant="Variant.Outlined">Ver todos</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MyLocation" Disabled="@(_findingNearest is not null)" OnClick="@(() => FindNearestAsync(NearestKind.BloodDonationCenter))">Encontrar el más cercano</MudButton>
    </HeaderActions>
    <ItemTemplate Context="center">
        <MudCard Class="h-100">
            <MudCardContent>
                <MudText Typo="Typo.h6">@center.Name</MudText>
                @if (center.ModerationStatus == BloodDonationModerationStatus.Pending)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">No verificado</MudChip>
                }
                <MudText Typo="Typo.body2">@center.Address</MudText>
                <MudText Typo="Typo.body2">@BloodDonationDisplay.BloodTypes(center.BloodTypes)</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="@($"/donacion-sangre/{center.Id}")" Size="Size.Small" Class="mt-2">Detalles</MudButton>
                <MudButton Href="@center.GoogleMapsUrl" Target="_blank" Class="mt-3">Abrir en Google Maps</MudButton>
            </MudCardActions>
        </MudCard>
    </ItemTemplate>
    <FooterActions>
        <MudButton Href="/donacion-sangre" Variant="Variant.Outlined">Ver todos</MudButton>
    </FooterActions>
</HomeCardSection>

<HomeCardSection TItem="ShelterSummaryResponse"
                 Title="Refugios"
                 Items="_shelters"
                 Loading="_loading"
                 EmptyText="No hay refugios abiertos publicados.">
    <HeaderActions>
        <MudButton Href="/refugios/nuevo" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.HomeWork">Registrar refugio</MudButton>
        <MudButton Href="/refugios" Variant="Variant.Outlined">Ver todos</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MyLocation" Disabled="@(_findingNearest is not null)" OnClick="@(() => FindNearestAsync(NearestKind.Shelter))">Encontrar el más cercano</MudButton>
    </HeaderActions>
    <ItemTemplate Context="shelter">
        <MudCard Class="h-100">
            <MudCardContent>
                <MudStack Row="true">
                    <MudText Typo="Typo.h6">@shelter.Name</MudText>
                    @if (shelter.ModerationStatus == ShelterModerationStatus.Pending)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">No verificado</MudChip>
                    }
                </MudStack>
                <MudText>@shelter.Address</MudText>
                <MudText Typo="Typo.body2">@shelter.Description</MudText>
                
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="@($"/refugios/{shelter.Id}")" Size="Size.Small" Class="mt-2">Detalles</MudButton>
                <MudButton Href="@shelter.GoogleMapsUrl" Target="_blank" Class="mt-3">Abrir en Google Maps</MudButton>
            </MudCardActions>
        </MudCard>
    </ItemTemplate>
    <FooterActions>
        <MudButton Href="/refugios" Variant="Variant.Outlined">Ver todos</MudButton>
    </FooterActions>
</HomeCardSection>



<HomeCardSection TItem="CollectionPointSummaryResponse"
                 Title="Centros de acopio"
                 Items="_collectionPoints"
                 Loading="_loading"
                 EmptyText="No hay centros de acopio abiertos publicados.">
    <HeaderActions>
        <MudButton Href="/collection-points/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.VolunteerActivism">Registrar centro</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MyLocation" Disabled="@(_findingNearest is not null)" OnClick="@(() => FindNearestAsync(NearestKind.CollectionPoint))">Encontrar el más cercano</MudButton>
    </HeaderActions>
    <ItemTemplate Context="point">
        <MudCard Class="h-100">
            <MudCardContent>
                <MudText Typo="Typo.h6">@point.Name</MudText>
                <MudText>@point.Address</MudText>
                <MudText Typo="Typo.body2"><strong>Necesidades:</strong> @point.NeedsSummary</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="@($"/collection-points/{point.Id}")" Size="Size.Small" Class="mt-2">Detalles</MudButton>
                <MudButton Href="@point.GoogleMapsUrl" Target="_blank" Class="mt-3">Abrir en Google Maps</MudButton>
            </MudCardActions>
        </MudCard>
    </ItemTemplate>
    <FooterActions>
        <MudButton Href="/collection-points" Variant="Variant.Outlined">Ver todos</MudButton>
    </FooterActions>
</HomeCardSection>

<SectionTitle Title="Reportes de Daños">
    <Actions>
        <MudButton Href="/report/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddAlert">Reportar daño</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Actualizar</MudButton>
    </Actions>
</SectionTitle>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6">
            <MudSelect T="SeverityLevel?" Label="Filtrar por gravedad" Value="_severityFilter" ValueChanged="OnSeverityChangedAsync" Clearable="true">
                <MudSelectItem T="SeverityLevel?" Value="@((SeverityLevel?)null)">Todas las gravedades</MudSelectItem>
                @foreach (var severity in Enum.GetValues<SeverityLevel>().OrderByDescending(value => value))
                {
                    <MudSelectItem T="SeverityLevel?" Value="severity">@severity.ToDisplayString()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="ReportSortOption" Label="Ordenar por" Value="_sortOption" ValueChanged="OnSortChangedAsync">
                <MudSelectItem Value="ReportSortOption.Newest">Más recientes</MudSelectItem>
                <MudSelectItem Value="ReportSortOption.Oldest">Más antiguos</MudSelectItem>
                <MudSelectItem Value="ReportSortOption.HighestSeverity">Mayor gravedad</MudSelectItem>
                <MudSelectItem Value="ReportSortOption.LowestSeverity">Menor gravedad</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (_totalCount == 0 && _severityFilter is null)
{
    <MudAlert Severity="Severity.Info">Aún no hay reportes de daños.</MudAlert>
}
else if (_totalCount == 0)
{
    <MudAlert Severity="Severity.Info">No hay reportes que coincidan con el filtro seleccionado.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        @foreach (var report in _reports)
        {
            <MudPaper Class="pa-4" Elevation="1" @onclick="() => NavigateToReport(report.Id)" Style="cursor:pointer">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="responsive-row">
                    <div>
                        <MudChip T="string" Color="@DisplayHelpers.SeverityColor(report.Severity)" Size="Size.Small">
                            @report.Severity.ToDisplayString()
                        </MudChip>
                        @if (report.StructureType is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @report.StructureType.Value.ToDisplayString()@(report.StructureSize is not null ? $" ({report.StructureSize.Value.ToDisplayString()})" : "")
                            </MudChip>
                        }
                        <MudText Typo="Typo.body1" Class="mt-2">@report.Description</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                            @foreach (var sign in report.DamageSigns.Split())
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@sign.ToDisplayString()</MudChip>
                            }
                        </MudStack>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@report.CreatedAt.ToLocalTime().ToString("g")</MudText>
                </MudStack>
            </MudPaper>
        }
    </MudStack>

    @if (_totalPages > 1)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-6">
            <MudPagination Count="_totalPages" Selected="_page" SelectedChanged="OnPageChangedAsync" />
        </MudStack>
    }
}

@code {
    private const int PageSize = 20;

    private IReadOnlyList<DamageReportSummaryResponse> _reports = [];
    private IReadOnlyList<CollectionPointSummaryResponse> _collectionPoints = [];
    private IReadOnlyList<ShelterSummaryResponse> _shelters = [];
    private IReadOnlyList<MissingPersonSummaryResponse> _missingPeople = [];
    private IReadOnlyList<HelpRequestSummaryResponse> _helpRequests = [];
    private IReadOnlyList<BloodDonationCenterSummaryResponse> _bloodDonationCenters = [];
    private EarthquakeResponse? _earthquake;
    private bool _loading = true;
    private SeverityLevel? _severityFilter;
    private ReportSortOption _sortOption = ReportSortOption.Newest;
    private int _page = 1;
    private int _totalCount;
    private int _totalPages;
    private CancellationTokenSource? _loadCancellation;
    private NearestKind? _findingNearest;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var cancellation = new CancellationTokenSource();
        var previousCancellation = Interlocked.Exchange(ref _loadCancellation, cancellation);
        previousCancellation?.Cancel();
        previousCancellation?.Dispose();

        _loading = true;
        try
        {
            var earthquakeTask = ApiClient.GetActiveEarthquakeAsync(cancellation.Token);
            var reportsTask = ApiClient.GetReportsAsync(_page, PageSize, _severityFilter, _sortOption, cancellation.Token);
            var missingPeopleTask = ApiClient.GetMissingPeopleAsync(page: 1, pageSize: 6, cancellationToken: cancellation.Token);
            var collectionPointsTask = ApiClient.GetCollectionPointsAsync(page: 1, pageSize: 6, cancellationToken: cancellation.Token);
            var sheltersTask = ApiClient.GetSheltersAsync(operationalStatus: ShelterOperationalStatus.Open, page: 1, pageSize: 6, cancellationToken: cancellation.Token);
            var helpRequestsTask = ApiClient.GetHelpRequestsAsync(page: 1, pageSize: 6, sort: HelpRequestSortOption.HighestPriority, cancellationToken: cancellation.Token);
            var bloodDonationTask = ApiClient.GetBloodDonationCentersAsync(page: 1, pageSize: 6, cancellationToken: cancellation.Token);

            await Task.WhenAll(earthquakeTask, reportsTask, missingPeopleTask, sheltersTask, collectionPointsTask, helpRequestsTask, bloodDonationTask);
            if (!ReferenceEquals(_loadCancellation, cancellation))
            {
                return;
            }

            _earthquake = await earthquakeTask;
            var response = await reportsTask;
            _reports = response.Items;
            _totalCount = response.TotalCount;
            _totalPages = response.TotalPages;
            _missingPeople = (await missingPeopleTask).Items;
            _shelters = (await sheltersTask).Items;
            _collectionPoints = (await collectionPointsTask).Items;
            _helpRequests = (await helpRequestsTask).Items;
            _bloodDonationCenters = (await bloodDonationTask).Items;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_loadCancellation, cancellation))
            {
                _loading = false;
            }
        }
    }

    private async Task OnSeverityChangedAsync(SeverityLevel? severity)
    {
        _severityFilter = severity;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSortChangedAsync(ReportSortOption sort)
    {
        _sortOption = sort;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private void NavigateToReport(Guid id) => Navigation.NavigateTo($"/report/{id}");
    private void NavigateToMissingPerson(Guid id) => Navigation.NavigateTo($"/missing-people/{id}");
    private static Color HelpPriorityColor(HelpRequestPriority priority) => priority switch { HelpRequestPriority.Critical => Color.Error, HelpRequestPriority.High => Color.Warning, _ => Color.Info };

    private async Task FindNearestAsync(NearestKind kind)
    {
        _findingNearest = kind;
        try
        {
            var location = await Geolocation.GetCurrentPositionAsync();
            if (location is not GeolocationResult.Success position)
            {
                var reason = ((GeolocationResult.Failure)location).Reason;
                Snackbar.Add(reason switch
                {
                    GeolocationFailureReason.Denied => "Necesitamos permiso para acceder a tu ubicación.",
                    GeolocationFailureReason.Timeout => "No pudimos obtener tu ubicación a tiempo. Inténtalo de nuevo.",
                    GeolocationFailureReason.Unsupported => "Tu navegador no admite servicios de ubicación.",
                    _ => "Tu ubicación no está disponible en este momento.",
                }, Severity.Warning);
                return;
            }

            string? destination = kind switch
            {
                NearestKind.BloodDonationCenter => (await ApiClient.GetBloodDonationCentersAsync(pageSize: 1, latitude: position.Latitude, longitude: position.Longitude)).Items.FirstOrDefault() is { } center ? $"/donacion-sangre/{center.Id}" : null,
                NearestKind.Shelter => (await ApiClient.GetSheltersAsync(operationalStatus: ShelterOperationalStatus.Open, pageSize: 1, latitude: position.Latitude, longitude: position.Longitude)).Items.FirstOrDefault() is { } shelter ? $"/refugios/{shelter.Id}" : null,
                _ => (await ApiClient.GetCollectionPointsAsync(operationalStatus: CollectionPointOperationalStatus.Open, pageSize: 1, latitude: position.Latitude, longitude: position.Longitude)).Items.FirstOrDefault() is { } point ? $"/collection-points/{point.Id}" : null,
            };

            if (destination is null)
                Snackbar.Add("No hay lugares abiertos con coordenadas disponibles.", Severity.Info);
            else
                Navigation.NavigateTo(destination);
        }
        catch (Exception)
        {
            Snackbar.Add("No pudimos buscar el lugar más cercano. Inténtalo de nuevo.", Severity.Error);
        }
        finally
        {
            _findingNearest = null;
        }
    }

    private enum NearestKind { BloodDonationCenter, Shelter, CollectionPoint }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
