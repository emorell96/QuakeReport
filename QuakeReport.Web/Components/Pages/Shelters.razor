@page "/refugios"
@inject QuakeReportApiClient ApiClient
@implements IDisposable

<PageTitle>Refugios - Terremoto.com.co</PageTitle>
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4 responsive-row">
    <MudText Typo="Typo.h5">Refugios</MudText>
    <MudButton Href="/refugios/nuevo" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.HomeWork">Registrar refugio</MudButton>
</MudStack>
<MudPaper Class="pa-4 mb-4">
    <MudTextField Label="Buscar por nombre, dirección, organización o descripción" @bind-Value="_query" />
    <MudGrid Class="mt-1">
        <MudItem xs="12" sm="4"><MudSelect T="ShelterOperationalStatus?" Label="Estado" @bind-Value="_operational" Clearable="true"><MudSelectItem T="ShelterOperationalStatus?" Value="@((ShelterOperationalStatus?)null)">Abiertos y llenos</MudSelectItem><MudSelectItem T="ShelterOperationalStatus?" Value="ShelterOperationalStatus.Open">Abiertos</MudSelectItem><MudSelectItem T="ShelterOperationalStatus?" Value="ShelterOperationalStatus.Full">Llenos</MudSelectItem><MudSelectItem T="ShelterOperationalStatus?" Value="ShelterOperationalStatus.Closed">Cerrados</MudSelectItem></MudSelect></MudItem>
        <MudItem xs="12" sm="4"><MudSelect T="ShelterModerationStatus?" Label="Verificación" @bind-Value="_moderation" Clearable="true"><MudSelectItem T="ShelterModerationStatus?" Value="@((ShelterModerationStatus?)null)">Todos</MudSelectItem><MudSelectItem T="ShelterModerationStatus?" Value="ShelterModerationStatus.Pending">No verificados</MudSelectItem><MudSelectItem T="ShelterModerationStatus?" Value="ShelterModerationStatus.Approved">Verificados</MudSelectItem></MudSelect></MudItem>
        <MudItem xs="12" sm="4"><MudSelect T="ShelterSortOption" Label="Ordenar" @bind-Value="_sort"><MudSelectItem Value="ShelterSortOption.Newest">Más recientes</MudSelectItem><MudSelectItem Value="ShelterSortOption.RecentlyUpdated">Actualizados recientemente</MudSelectItem><MudSelectItem Value="ShelterSortOption.Name">Nombre</MudSelectItem></MudSelect></MudItem>
    </MudGrid>
    <MudButton Class="mt-2" OnClick="SearchAsync">Buscar</MudButton>
</MudPaper>

@if (_loading) { <MudProgressCircular Indeterminate="true" /> }
else if (_items.Count == 0) { <MudAlert Severity="Severity.Info">No hay refugios para mostrar.</MudAlert> }
else
{
    <MudGrid>
        @foreach (var shelter in _items)
        {
            <MudItem xs="12" sm="6"><MudCard Class="h-100"><MudCardContent>
                <MudStack Row="true" Spacing="1" Class="responsive-row"><MudText Typo="Typo.h6">@shelter.Name</MudText>@if (shelter.ModerationStatus == ShelterModerationStatus.Pending) { <MudChip T="string" Color="Color.Warning" Size="Size.Small">No verificado</MudChip> } else if (shelter.Source == ShelterSource.Official) { <MudChip T="string" Color="Color.Info" Size="Size.Small">Oficial</MudChip> } else { <MudChip T="string" Color="Color.Success" Size="Size.Small">Verificado</MudChip> }</MudStack>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(shelter.OperationalStatus)">@StatusText(shelter.OperationalStatus)</MudChip>
                <MudText Class="mt-2">@shelter.Address</MudText><MudText Typo="Typo.body2">@shelter.Description</MudText>
                <MudStack Row="true" Class="mt-2 responsive-actions"><MudButton Href="@($"/refugios/{shelter.Id}")" Size="Size.Small">Ver detalles</MudButton><MudButton Href="@shelter.GoogleMapsUrl" Target="_blank" Size="Size.Small">Google Maps</MudButton></MudStack>
            </MudCardContent></MudCard></MudItem>
        }
    </MudGrid>
    @if (_totalPages > 1) { <MudPagination Class="mt-6" Count="_totalPages" Selected="_page" SelectedChanged="PageChangedAsync" /> }
}

@code {
    private IReadOnlyList<ShelterSummaryResponse> _items = [];
    private string? _query; private ShelterOperationalStatus? _operational; private ShelterModerationStatus? _moderation;
    private ShelterSortOption _sort = ShelterSortOption.Newest; private int _page = 1, _totalPages; private bool _loading; private CancellationTokenSource? _cts;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task SearchAsync() { _page = 1; await LoadAsync(); }
    private async Task PageChangedAsync(int page) { _page = page; await LoadAsync(); }
    private async Task LoadAsync()
    {
        var cts = new CancellationTokenSource(); var previous = Interlocked.Exchange(ref _cts, cts); previous?.Cancel(); previous?.Dispose(); _loading = true;
        try { var response = await ApiClient.GetSheltersAsync(_query, _operational, _moderation, _sort, _page, 20, cts.Token); if (ReferenceEquals(_cts, cts)) { _items = response.Items; _totalPages = response.TotalPages; } }
        catch (OperationCanceledException) when (cts.IsCancellationRequested) { }
        finally { if (ReferenceEquals(_cts, cts)) _loading = false; }
    }
    private static string StatusText(ShelterOperationalStatus status) => status switch { ShelterOperationalStatus.Open => "Abierto", ShelterOperationalStatus.Full => "Lleno", ShelterOperationalStatus.Closed => "Cerrado", _ => status.ToString() };
    private static Color StatusColor(ShelterOperationalStatus status) => status switch { ShelterOperationalStatus.Open => Color.Success, ShelterOperationalStatus.Full => Color.Warning, _ => Color.Default };
    public void Dispose() { _cts?.Cancel(); _cts?.Dispose(); }
}
