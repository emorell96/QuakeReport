@page "/collection-points/new"
@inject QuakeReportApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>Registrar centro de acopio - Terremoto.com.co</PageTitle>
<MudText Typo="Typo.h5">Registrar centro de acopio</MudText>
<MudText Class="mb-4">El centro aparecerá como no verificado mientras un moderador revisa la información.</MudText>

<MudForm @ref="_form" Model="_model" Validation="_validator.ValidateValue">
    <MudPaper Class="pa-4">
        <MudTextField Label="Nombre del centro*" @bind-Value="_model.Name" For="@(() => _model.Name)" />
        <MudTextField Label="Organización" @bind-Value="_model.OrganizationName" For="@(() => _model.OrganizationName)" />
        <AddressSearch Label="Dirección*" @bind-Address="_model.Address"
                       Latitude="_model.Latitude" Longitude="_model.Longitude"
                       For="@(() => _model.Address)" OnPlaceSelected="OnPlaceSelected"
                       OnCoordinatesCleared="ClearCoordinates" />
        <MudTextField Label="Qué se necesita actualmente*" Lines="3" @bind-Value="_model.NeedsSummary" For="@(() => _model.NeedsSummary)" />
        <MudTextField Label="Instrucciones y horarios de recepción*" Lines="3" @bind-Value="_model.ReceivingInstructions" For="@(() => _model.ReceivingInstructions)" />
        <MudTextField Label="Descripción" Lines="3" @bind-Value="_model.Description" For="@(() => _model.Description)" />
        <MudTextField Label="Contacto público (opcional)" @bind-Value="_model.ContactName" For="@(() => _model.ContactName)" />
        <MudTextField Label="Teléfono" @bind-Value="_model.Phone" For="@(() => _model.Phone)" />
        <MudTextField Label="WhatsApp" @bind-Value="_model.WhatsApp" For="@(() => _model.WhatsApp)" />
        <MudTextField Label="Correo" @bind-Value="_model.Email" For="@(() => _model.Email)" />
        <MudDatePicker Label="Fecha de cierre prevista (opcional)" @bind-Date="_model.EndsAt" For="@(() => _model.EndsAt)" />
        <PrivacyConsent @bind-Value="_model.PrivacyConsent" For="@(() => _model.PrivacyConsent)" />
        <Turnstile SiteKey="@Configuration["Turnstile:SiteKey"]" @bind-Token="_model.TurnstileToken" />
        <MudButton Class="mt-4 responsive-primary-action" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Registrar</MudButton>
        @if (_code is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4">Guarda este código de administración; se muestra una sola vez: <strong>@_code</strong></MudAlert>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }
    </MudPaper>
</MudForm>
