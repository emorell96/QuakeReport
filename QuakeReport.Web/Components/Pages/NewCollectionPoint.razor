@page "/collection-points/new"
@inject QuakeReportApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>Registrar centro de acopio - Terremoto.com.co</PageTitle>
<MudText Typo="Typo.h5">Registrar centro de acopio</MudText>
<MudText Class="mb-4">El centro aparecerá como no verificado mientras un moderador revisa la información.</MudText>
<MudPaper Class="pa-4">
    <MudTextField Label="Nombre del centro*" @bind-Value="_name" Required="true" />
    <MudTextField Label="Organización" @bind-Value="_organization" />
    <AddressSearch @bind-Address="_address" Latitude="_latitude" Longitude="_longitude" OnPlaceSelected="OnPlaceSelected" />
    <MudTextField Label="Qué se necesita actualmente*" Lines="3" @bind-Value="_needs" Required="true" />
    <MudTextField Label="Instrucciones y horarios de recepción*" Lines="3" @bind-Value="_instructions" Required="true" />
    <MudTextField Label="Descripción" Lines="3" @bind-Value="_description" />
    <MudTextField Label="Contacto público (opcional)" @bind-Value="_contactName" />
    <MudTextField Label="Teléfono" @bind-Value="_phone" />
    <MudTextField Label="WhatsApp" @bind-Value="_whatsapp" />
    <MudTextField Label="Correo" @bind-Value="_email" />
    <MudDatePicker Label="Fecha de cierre prevista (opcional)" @bind-Date="_endsAt" />
    <Turnstile SiteKey="@Configuration["Turnstile:SiteKey"]" @bind-Token="_turnstile" />
    <MudButton Class="mt-4" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">Registrar</MudButton>
    @if (_code is not null) { <MudAlert Severity="Severity.Warning" Class="mt-4">Guarda este código de administración; se muestra una sola vez: <strong>@_code</strong></MudAlert> }
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert> }
</MudPaper>
@code {
    private string? _name, _organization, _address, _needs, _instructions, _description, _contactName, _phone, _whatsapp, _email, _turnstile, _code, _error; private double? _latitude, _longitude; private DateTime? _endsAt; private bool _saving;
    private void OnPlaceSelected((string Address, double Latitude, double Longitude) value) { _address = value.Address; _latitude = value.Latitude; _longitude = value.Longitude; }
    private async Task SubmitAsync()
    {
        _saving = true; _error = null;
        try
        {
            var result = await ApiClient.CreateCollectionPointAsync(new(_name ?? "", _organization, _address ?? "", _latitude, _longitude, _description, _needs ?? "", _instructions ?? "", _contactName, _phone, _whatsapp, _email, _endsAt is null ? null : new DateTimeOffset(DateTime.SpecifyKind(_endsAt.Value, DateTimeKind.Unspecified), TimeSpan.Zero), _turnstile ?? ""));
            _code = result.ManagementCode;
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }
}
