@page "/ayuda/administrar"
@inject QuakeReportApiClient ApiClient
@inject NavigationManager Navigation
<PageTitle>Administrar solicitud - Terremoto.com.co</PageTitle><MudText Typo="Typo.h5">Administrar solicitud de ayuda</MudText><MudPaper Class="pa-4 mt-4"><MudTextField Label="Código de administración" @bind-Value="_code" InputType="InputType.Password" /><MudButton Class="mt-3" Variant="Variant.Filled" OnClick="LoadAsync">Buscar</MudButton>@if(_error is not null){<MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>}</MudPaper>
@if(_request is not null){<MudPaper Class="pa-4 mt-4"><MudTextField Label="Título" @bind-Value="_title"/><MudTextField Label="Qué ayuda necesitan" Lines="4" @bind-Value="_details"/><AddressSearch @bind-Address="_address" Latitude="_latitude" Longitude="_longitude" OnPlaceSelected="OnPlaceSelected" OnCoordinatesCleared="ClearCoordinates"/><MudTextField Label="Teléfono público" @bind-Value="_phone"/><MudSelect T="HelpRequestStatus" Label="Estado" @bind-Value="_status"><MudSelectItem Value="HelpRequestStatus.Active">Activa</MudSelectItem><MudSelectItem Value="HelpRequestStatus.Assigned">Asignada</MudSelectItem><MudSelectItem Value="HelpRequestStatus.Resolved">Resuelta</MudSelectItem></MudSelect><MudButton Class="mt-3" Variant="Variant.Filled" OnClick="SaveAsync">Guardar cambios</MudButton></MudPaper>}
@code { private string? _code,_title,_details,_address,_phone,_error;private double? _latitude,_longitude;private HelpRequestStatus _status;private HelpRequestResponse? _request;private async Task LoadAsync(){try{_request=await ApiClient.LookupHelpRequestByManagementCodeAsync(_code??"")??throw new InvalidOperationException("No se encontró la solicitud o el código no es válido.");_title=_request.Title;_details=_request.NeedDetails;_address=_request.Address;_latitude=_request.Latitude;_longitude=_request.Longitude;_phone=_request.PublicPhone;_status=_request.Status;}catch(Exception e){_error=e.Message;}}private void OnPlaceSelected((string Address,double Latitude,double Longitude)v){_address=v.Address;_latitude=v.Latitude;_longitude=v.Longitude;}private void ClearCoordinates(){_latitude=null;_longitude=null;}private async Task SaveAsync(){try{_request=await ApiClient.UpdateHelpRequestAsync(_request!.Id,_code??"",new(_title??"",_request.RequesterName,_request.OrganizationName,_address??"",_latitude,_longitude,_details??"",_request.Instructions,_phone??"",_request.PublicWhatsApp,_request.PublicEmail,_request.Priority,_request.NeedCategories,_request.NeededBy));_request=await ApiClient.UpdateHelpRequestStatusAsync(_request.Id,_code??"",_status); }catch(Exception e){_error=e.Message;}}}
