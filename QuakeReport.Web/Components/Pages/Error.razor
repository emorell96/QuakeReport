@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar tu solicitud.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID de solicitud:</strong> <code>@requestId</code>
    </p>
}

<h3>Modo de Desarrollo</h3>
<p>
    Cambiar al entorno <strong>Development</strong> mostrará información más detallada sobre el error ocurrido.
</p>
<p>
    <strong>El entorno Development no debe habilitarse en aplicaciones desplegadas.</strong>
    Puede resultar en mostrar información sensible de las excepciones a los usuarios finales.
    Para depuración local, habilita el entorno <strong>Development</strong> configurando la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong>
    y reiniciando la aplicación.
</p>

@code{
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? requestId;
    private bool ShowRequestId => !string.IsNullOrEmpty(requestId);

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
