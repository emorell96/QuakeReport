@page "/donacion-sangre/administrar"
@inject QuakeReportApiClient ApiClient
<PageTitle>Administrar centro de donación - Terremoto.com.co</PageTitle><MudText Typo="Typo.h5">Administrar centro de donación</MudText><MudPaper Class="pa-4 mt-4"><MudTextField Label="Código de administración" InputType="InputType.Password" @bind-Value="_code"/><MudButton Class="mt-3" Variant="Variant.Filled" OnClick="LoadAsync">Buscar</MudButton></MudPaper>@if(_error is not null){<MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>}@if(_center is not null){<MudPaper Class="pa-4 mt-4"><MudTextField Label="Nombre" @bind-Value="_name"/><MudTextField Label="Resumen de necesidades" Lines="3" @bind-Value="_needs"/><MudTextField Label="Teléfono público" @bind-Value="_phone"/><MudSelect T="BloodDonationOperationalStatus" Label="Estado" @bind-Value="_status"><MudSelectItem Value="BloodDonationOperationalStatus.Open">Abierto</MudSelectItem><MudSelectItem Value="BloodDonationOperationalStatus.TemporarilyUnavailable">No disponible temporalmente</MudSelectItem><MudSelectItem Value="BloodDonationOperationalStatus.Closed">Cerrado</MudSelectItem></MudSelect><MudButton Class="mt-3" Variant="Variant.Filled" OnClick="SaveAsync">Guardar cambios</MudButton></MudPaper>}
@code{private string? _code,_name,_needs,_phone,_error;private BloodDonationOperationalStatus _status;private BloodDonationCenterResponse? _center;private async Task LoadAsync(){try{_center=await ApiClient.LookupBloodDonationCenterByManagementCodeAsync(_code??"")??throw new InvalidOperationException("No se encontró el centro o el código no es válido.");_name=_center.Name;_needs=_center.NeedsSummary;_phone=_center.PublicPhone;_status=_center.OperationalStatus;}catch(Exception e){_error=e.Message;}}private async Task SaveAsync(){try{_center=await ApiClient.UpdateBloodDonationCenterAsync(_center!.Id,_code??"",new(_name??_center.Name,_center.OrganizationName,_center.Address,_center.Latitude,_center.Longitude,_center.Description,_center.OperatingInstructions,_needs??_center.NeedsSummary,_phone??_center.PublicPhone,_center.PublicWhatsApp,_center.PublicEmail,_center.CenterType,_center.BloodTypes,_center.Components,_center.StartsAt,_center.EndsAt));_center=await ApiClient.UpdateBloodDonationCenterStatusAsync(_center.Id,_code??"",_status);}catch(Exception e){_error=e.Message;}}}
