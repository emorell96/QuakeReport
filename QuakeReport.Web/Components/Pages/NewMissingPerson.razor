@page "/missing-people/new"
@inject QuakeReportApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>Registrar persona extraviada - Terremoto.com.co</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Registrar persona extraviada</MudText>

<MudForm @ref="_form" Model="_model" Validation="_validator.ValidateValue">
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">Información de la persona</MudText>
        <MudTextField Label="Nombre completo*" @bind-Value="_model.FullName" For="@(() => _model.FullName)" />
        <MudTextField Label="Alias u otros nombres" @bind-Value="_model.Aliases" For="@(() => _model.Aliases)" />
        <MudTextField Label="Edad aproximada" @bind-Value="_model.ApproximateAge" For="@(() => _model.ApproximateAge)" />
        <MudSelect T="IdentificationDocumentType?" Label="Tipo de documento" @bind-Value="_model.IdentificationDocumentType"
                   For="@(() => _model.IdentificationDocumentType)" Clearable="true">
            <MudSelectItem T="IdentificationDocumentType?" Value="@((IdentificationDocumentType?)IdentificationDocumentType.ColombianCitizenId)">Cédula</MudSelectItem>
            <MudSelectItem T="IdentificationDocumentType?" Value="@((IdentificationDocumentType?)IdentificationDocumentType.IdentityCard)">Tarjeta de identidad</MudSelectItem>
            <MudSelectItem T="IdentificationDocumentType?" Value="@((IdentificationDocumentType?)IdentificationDocumentType.CivilRegistry)">Registro civil</MudSelectItem>
            <MudSelectItem T="IdentificationDocumentType?" Value="@((IdentificationDocumentType?)IdentificationDocumentType.ForeignerId)">Cédula de extranjería</MudSelectItem>
            <MudSelectItem T="IdentificationDocumentType?" Value="@((IdentificationDocumentType?)IdentificationDocumentType.Passport)">Pasaporte</MudSelectItem>
        </MudSelect>
        <MudTextField Label="Número de documento (opcional)" @bind-Value="_model.IdentificationNumber" For="@(() => _model.IdentificationNumber)" />
        <MudDatePicker Label="Fecha del último avistamiento" @bind-Date="_model.LastSeenAt" For="@(() => _model.LastSeenAt)" />
        <MudTextField Label="Descripción*" Lines="4" @bind-Value="_model.Description" For="@(() => _model.Description)" />
        <MudTextField Label="Descripción física" Lines="3" @bind-Value="_model.PhysicalDescription" For="@(() => _model.PhysicalDescription)" />
        <MudTextField Label="Ropa u otros detalles" Lines="3" @bind-Value="_model.ClothingDescription" For="@(() => _model.ClothingDescription)" />
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">Fotografía de la persona (opcional)</MudText>
        <InputFile OnChange="OnPhotoSelected" accept="image/jpeg,image/png,image/webp" />
        <MudText Typo="Typo.caption">JPEG, PNG o WebP. Tamaño máximo: 10 MB.</MudText>
        @if (_photoError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_photoError</MudAlert>
        }
        @if (_model.Photo is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-2">Archivo seleccionado: @_model.Photo.Name</MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">Posibles ubicaciones*</MudText>
        @foreach (var location in _model.Locations.Select((value, index) => (value, index)))
        {
            <MudForm Model="location.value" Validation="_locationValidator.ValidateValue">
                <AddressSearch Label="Dirección*" @bind-Address="location.value.Address"
                               Latitude="location.value.Latitude" Longitude="location.value.Longitude"
                               For="@(() => location.value.Address)"
                               OnPlaceSelected="@(details => SetLocation(location.value, details))"
                               OnCoordinatesCleared="@(() => ClearCoordinates(location.value))" />
                <MudTextField Label="Nota" @bind-Value="location.value.Note" For="@(() => location.value.Note)" />
                @if (_model.Locations.Count > 1)
                {
                    <MudButton OnClick="@(() => RemoveLocation(location.index))">Eliminar ubicación</MudButton>
                }
            </MudForm>
        }
        <MudButton Class="mt-2" OnClick="AddLocation" StartIcon="@Icons.Material.Filled.Add">Agregar dirección</MudButton>
    </MudPaper>

    <PrivacyConsent @bind-Value="_model.PrivacyConsent" For="@(() => _model.PrivacyConsent)"
                    Label="Confirmo que tengo autorización para publicar esta información y fotografía y acepto la" />
    <Turnstile SiteKey="@Configuration["Turnstile:SiteKey"]" @bind-Token="_model.TurnstileToken" />
    <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_saving">Registrar</MudButton>
</MudForm>

@if (_managementCode is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">Guarda este código de administración; no podremos recuperarlo: <strong>@_managementCode</strong></MudAlert>
    @if (_createdId is not null)
    {
        <MudButton Class="mt-2" Href="@($"/missing-people/{_createdId}/manage")">Administrar este registro</MudButton>
    }
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}
