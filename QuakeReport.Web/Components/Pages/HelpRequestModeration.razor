@page "/ayuda/admin"
@inject QuakeReportApiClient ApiClient
@inject AuthenticationStateProvider Auth
<PageTitle>Moderar solicitudes - Terremoto.com.co</PageTitle><MudText Typo="Typo.h5">Moderar solicitudes de ayuda</MudText><MudButton Class="my-4" OnClick="LoadAsync">Actualizar</MudButton>@if(_error is not null){<MudAlert Severity="Severity.Error">@_error</MudAlert>}<MudStack Spacing="2">@foreach(var item in _items){<MudPaper Class="pa-4"><MudText Typo="Typo.h6">@item.Title</MudText><MudText>@item.RequesterName · @item.Address</MudText><MudText>@item.NeedDetails</MudText><MudButton Color="Color.Success" OnClick="@(()=>ModerateAsync(item.Id,HelpRequestModerationStatus.Approved))">Aprobar</MudButton><MudButton Color="Color.Error" OnClick="@(()=>ModerateAsync(item.Id,HelpRequestModerationStatus.Rejected))">Rechazar</MudButton><MudButton OnClick="@(()=>Select(item))">Editar</MudButton></MudPaper>}</MudStack>
@if(_selected is not null){<MudPaper Class="pa-4 mt-4"><MudText Typo="Typo.h6">Editar solicitud</MudText><MudTextField Label="Título" @bind-Value="_editTitle"/><MudTextField Label="Necesidad" Lines="4" @bind-Value="_editDetails"/><MudTextField Label="Dirección" @bind-Value="_editAddress"/><MudButton Class="mt-3" Variant="Variant.Filled" OnClick="SaveEditAsync">Guardar edición</MudButton></MudPaper>}
@code {private IReadOnlyList<HelpRequestSummaryResponse> _items=[];private string? _error,_editTitle,_editDetails,_editAddress;private HelpRequestSummaryResponse? _selected;protected override async Task OnInitializedAsync()=>await LoadAsync();private async Task LoadAsync(){try{_items=(await ApiClient.GetPendingHelpRequestsAsync()).Results.ToList();}catch(Exception e){_error=e.Message;}}private void Select(HelpRequestSummaryResponse item){_selected=item;_editTitle=item.Title;_editDetails=item.NeedDetails;_editAddress=item.Address;}private async Task ModerateAsync(Guid id,HelpRequestModerationStatus status){try{var user=await Auth.GetAuthenticationStateAsync();await ApiClient.ModerateHelpRequestAsync(id,status,user.User.Identity?.Name);await LoadAsync();}catch(Exception e){_error=e.Message;}}private async Task SaveEditAsync(){try{var detail=await ApiClient.GetHelpRequestAsync(_selected!.Id)??throw new InvalidOperationException("No se encontró la solicitud.");await ApiClient.ModeratorUpdateHelpRequestAsync(detail.Id,new(_editTitle??detail.Title,detail.RequesterName,detail.OrganizationName,_editAddress??detail.Address,detail.Latitude,detail.Longitude,_editDetails??detail.NeedDetails,detail.Instructions,detail.PublicPhone,detail.PublicWhatsApp,detail.PublicEmail,detail.Priority,detail.NeedCategories,detail.NeededBy));_selected=null;await LoadAsync();}catch(Exception e){_error=e.Message;}}}
