@page "/ayuda/nueva"
@inject QuakeReportApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>Publicar solicitud de ayuda - Terremoto.com.co</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Publicar solicitud de ayuda</MudText>
<MudAlert Severity="Severity.Warning" Class="mb-4">Las solicitudes aparecen como <strong>No verificado</strong> hasta que un moderador las revise. El teléfono o WhatsApp será público.</MudAlert>

<MudForm @ref="_form" Model="_model" Validation="_validator.ValidateValue">
    <MudPaper Class="pa-4">
        <MudTextField Label="Título*" @bind-Value="_model.Title" For="@(() => _model.Title)" />
        <MudTextField Label="Equipo o persona solicitante*" @bind-Value="_model.RequesterName" For="@(() => _model.RequesterName)" />
        <MudTextField Label="Organización" @bind-Value="_model.OrganizationName" For="@(() => _model.OrganizationName)" />
        <AddressSearch Label="Dirección*" @bind-Address="_model.Address"
                       Latitude="_model.Latitude" Longitude="_model.Longitude"
                       For="@(() => _model.Address)" OnPlaceSelected="OnPlaceSelected"
                       OnCoordinatesCleared="ClearCoordinates" />
        <MudTextField Label="¿Qué ayuda necesitan?*" Lines="4" @bind-Value="_model.NeedDetails" For="@(() => _model.NeedDetails)" />
        <MudTextField Label="Instrucciones adicionales" Lines="3" @bind-Value="_model.Instructions" For="@(() => _model.Instructions)" />
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="HelpRequestPriority" Label="Prioridad" @bind-Value="_model.Priority" For="@(() => _model.Priority)">
                    <MudSelectItem Value="HelpRequestPriority.Low">Baja</MudSelectItem>
                    <MudSelectItem Value="HelpRequestPriority.Medium">Media</MudSelectItem>
                    <MudSelectItem Value="HelpRequestPriority.High">Alta</MudSelectItem>
                    <MudSelectItem Value="HelpRequestPriority.Critical">Crítica</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="HelpNeedCategory" Label="Qué tipo de ayuda necesitan" @bind-Value="_model.NeedCategories" For="@(() => _model.NeedCategories)">
                    <MudSelectItem Value="HelpNeedCategory.Personnel">Personal de apoyo</MudSelectItem>
                    <MudSelectItem Value="HelpNeedCategory.Medical">Asistencia o suministros médicos</MudSelectItem>
                    <MudSelectItem Value="HelpNeedCategory.RescueEquipment">Equipos de rescate</MudSelectItem>
                    <MudSelectItem Value="HelpNeedCategory.Machinery">Maquinaria</MudSelectItem>
                    <MudSelectItem Value="HelpNeedCategory.Transportation">Transporte</MudSelectItem>
                    <MudSelectItem Value="HelpNeedCategory.FoodAndWater">Alimentos y agua</MudSelectItem>
                    <MudSelectItem Value="HelpNeedCategory.Communications">Comunicaciones</MudSelectItem>
                    <MudSelectItem Value="HelpNeedCategory.TemporaryShelter">Alojamiento temporal</MudSelectItem>
                    <MudSelectItem Value="HelpNeedCategory.Security">Seguridad</MudSelectItem>
                    <MudSelectItem Value="HelpNeedCategory.Other">Otro</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
        <MudTextField Label="Teléfono público" @bind-Value="_model.Phone" For="@(() => _model.Phone)" />
        <MudTextField Label="WhatsApp público" @bind-Value="_model.WhatsApp" For="@(() => _model.WhatsApp)" />
        <MudTextField Label="Correo público" @bind-Value="_model.Email" For="@(() => _model.Email)" />
        <MudDatePicker Label="Necesitado antes de" @bind-Date="_model.NeededBy" For="@(() => _model.NeededBy)" />
        <PrivacyConsent @bind-Value="_model.PrivacyConsent" For="@(() => _model.PrivacyConsent)"
                        Label="Confirmo que tengo autorización y acepto publicar estos datos de contacto y" />
        <Turnstile SiteKey="@Configuration["Turnstile:SiteKey"]" @bind-Token="_model.TurnstileToken" />
        <MudButton Class="mt-4 responsive-primary-action" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">PUBLICAR SOLICITUD</MudButton>
        @if (_code is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4">Guarda este código de administración; se muestra una sola vez: <strong>@_code</strong></MudAlert>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }
    </MudPaper>
</MudForm>
