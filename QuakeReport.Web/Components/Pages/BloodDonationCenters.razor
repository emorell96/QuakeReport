@page "/donacion-sangre"
@implements IDisposable
@inject QuakeReportApiClient ApiClient
@inject NavigationManager Navigation
@inject ShareService Share
<PageTitle>Donación de sangre - Terremoto.com.co</PageTitle>
<MudText Typo="Typo.h5">Donación de sangre</MudText><MudButton Href="/donacion-sangre/nuevo" Class="my-4" Variant="Variant.Filled">Registrar centro</MudButton>
<MudAlert Severity="Severity.Info" Class="mb-4">Confirma directamente con el centro la disponibilidad, los requisitos y los horarios. Esta información no representa inventario médico en tiempo real.</MudAlert>
<MudPaper Class="pa-4 mb-4"><MudTextField Label="Buscar" @bind-Value="_query"/><MudButton Class="mt-3" OnClick="ReloadAsync">Buscar</MudButton></MudPaper>
@if(_loading){<MudProgressCircular Indeterminate="true"/>}else if(_items.Count==0){<MudAlert Severity="Severity.Info">No hay centros de donación para mostrar.</MudAlert>}else{<MudGrid Spacing="2">@foreach(var center in _items){<MudItem xs="12" md="6"><MudCard Class="h-100"><MudCardContent><MudText Typo="Typo.h6">@center.Name</MudText><MudChip T="string" Size="Size.Small">@BloodDonationDisplay.Status(center.OperationalStatus)</MudChip>@if(center.ModerationStatus==BloodDonationModerationStatus.Pending){<MudChip T="string" Color="Color.Warning" Size="Size.Small">No verificado</MudChip>}else if(center.Source==BloodDonationSource.Official){<MudChip T="string" Color="Color.Info" Size="Size.Small">Oficial</MudChip>}else{<MudChip T="string" Color="Color.Success" Size="Size.Small">Verificado</MudChip>}<MudText Typo="Typo.body2">@center.Address</MudText><MudText Class="mt-2"><strong>Grupos:</strong> @BloodDonationDisplay.BloodTypes(center.BloodTypes)</MudText><MudText Typo="Typo.body2"><strong>Componentes:</strong> @BloodDonationDisplay.Components(center.Components)</MudText><MudButton Href="@($"/donacion-sangre/{center.Id}")" Size="Size.Small" Class="mt-3">Ver detalles</MudButton><MudButton Href="@center.GoogleMapsUrl" Target="_blank" Size="Size.Small">Google Maps</MudButton><MudButton Size="Size.Small" OnClick="@(() => ShareAsync(center))">Compartir</MudButton></MudCardContent></MudCard></MudItem>}}</MudGrid>}
@if(_totalPages>1){<MudPagination Class="mt-5" Count="_totalPages" Selected="_page" SelectedChanged="OnPageChangedAsync"/>}
@code{private IReadOnlyList<BloodDonationCenterSummaryResponse> _items=[];private string? _query;private int _page=1,_totalPages;private bool _loading;private CancellationTokenSource? _cts;protected override async Task OnInitializedAsync()=>await ReloadAsync();private async Task ReloadAsync(){var c=new CancellationTokenSource();var old=Interlocked.Exchange(ref _cts,c);old?.Cancel();old?.Dispose();_loading=true;try{var r=await ApiClient.GetBloodDonationCentersAsync(_query,page:_page,pageSize:20,cancellationToken:c.Token);if(ReferenceEquals(_cts,c)){_items=r.Items;_totalPages=r.TotalPages;}}catch(OperationCanceledException)when(c.IsCancellationRequested){}finally{if(ReferenceEquals(_cts,c))_loading=false;}}private Task OnPageChangedAsync(int page){_page=page;return ReloadAsync();}private Task ShareAsync(BloodDonationCenterSummaryResponse center)=>Share.ShareAsync(center.Name,"Centro de donación de sangre",Navigation.ToAbsoluteUri($"/donacion-sangre/{center.Id}").ToString());public void Dispose(){_cts?.Cancel();_cts?.Dispose();}}
